# Discord Bot Token (Get from Discord Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=your_bot_token_here

# Target User IDs separated by commas to auto-react whenever any of them are mentioned/tagged
# (Right-click each user in Discord -> "Copy User ID")
TARGET_USER_IDS=111111111111111111, 222222222222222222, 333333333333333333, 444444444444444444
